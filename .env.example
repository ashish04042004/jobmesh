# Copy to .env. Used by `npm run dev:api` / `npm run dev:worker` (via --env-file)
# and by docker compose for variable substitution.

NODE_ENV=development
LOG_LEVEL=info

MONGO_URI=mongodb://localhost:27017/jobmesh
REDIS_URL=redis://localhost:6379
# Shared by API (uploads) and workers (inputs/artifacts). Defaults to ./data
# DATA_DIR=./data

# API
PORT=4000
# Required in production: at least 32 random characters.
JWT_SECRET=change-me-to-a-long-random-string-0123456789
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_JOBS_PER_MIN=100
RATE_LIMIT_AUTH_PER_MIN=20
CACHE_JOB_TTL_SEC=60
CACHE_STATS_TTL_SEC=5

# Queue / retries (exponential backoff: 1s, 2s, 4s, ...)
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=1000

# Worker
WORKER_CONCURRENCY=2
SHARP_CONCURRENCY=1
